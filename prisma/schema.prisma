  @@index([tenantId])
  @@index([handoffId])
  @@index([inventoryId])
}

model Inventory {
  id                   String                 @id @default(cuid())
  tenantId             String
  partNumber           String
  name                 String
  description          String?
  category             String?
  batch                String?
  quantity             Float                  @default(0)
  reservedQty          Float                  @default(0)
  availableQty         Float                  @default(0)
  unit                 String?
  locationId           String?
  shelfId              String?
