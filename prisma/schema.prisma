  inventory             Inventory            @relation(fields: [inventoryId], references: [id])

  @@index([tenantId])
  @@index([inventoryId])
  @@index([materialRequirementId])
  @@index([orderId])
  @@index([moId])
  @@index([status])
}

model InventoryTransaction {
  id                 String              @id @default(cuid())
  tenantId           String
  inventoryId        String
