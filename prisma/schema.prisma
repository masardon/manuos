generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BusinessUnit {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Board {
  id             String   @id @default(cuid())
  tenantId       String
  businessUnitId String
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, businessUnitId, code])
  @@index([tenantId])
  @@index([businessUnitId])
}

model Workflow {
  id          String               @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  entityType  WorkflowEntityType
  isActive    Boolean              @default(true)
  isDefault   Boolean              @default(false)
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  mos         ManufacturingOrder[]
  orders      Order[]
  states      WorkflowState[]
  transitions WorkflowTransition[]

  @@unique([tenantId, code, entityType])
  @@index([tenantId])
  @@index([entityType])
}

model WorkflowState {
  id              String               @id @default(cuid())
  tenantId        String
  workflowId      String
  code            String
  name            String
  description     String?
  order           Int                  @default(0)
  color           String?              @default("#gray")
  icon            String?
  isInitial       Boolean              @default(false)
  isFinal         Boolean              @default(false)
  allowSelfAssign Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  mos             ManufacturingOrder[] @relation("MOCurrentState")
  orders          Order[]              @relation("OrderCurrentState")
  workflow        Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  toTransitions   WorkflowTransition[] @relation("ToStateTransitions")
  fromTransitions WorkflowTransition[] @relation("FromStateTransitions")

  @@unique([workflowId, code])
  @@index([tenantId])
  @@index([workflowId])
}

model WorkflowTransition {
  id              String        @id @default(cuid())
  tenantId        String
  workflowId      String
  fromStateId     String
  toStateId       String
  code            String
  name            String
  description     String?
  order           Int           @default(0)
  condition       String?
  allowedRoles    String        @default("")
  requireApproval Boolean       @default(false)
  approverRoles   String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  toState         WorkflowState @relation("ToStateTransitions", fields: [toStateId], references: [id])
  fromState       WorkflowState @relation("FromStateTransitions", fields: [fromStateId], references: [id])
  workflow        Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, fromStateId, toStateId])
  @@index([tenantId])
  @@index([workflowId])
}

model Order {
  id                  String                 @id @default(cuid())
  tenantId            String
  boardId             String
  orderNumber         String
  customerName        String
  customerEmail       String?
  customerPhone       String?
  workflowId          String?
  currentStateId      String?
  status              OrderStatus            @default("DRAFT")
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  progressPercent     Float                  @default(0)
  drawingUrl          String?
  notes               String?
  createdBy           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  reservations        InventoryReservation[]
  transactions        InventoryTransaction[]
  manufacturingOrders ManufacturingOrder[]
  currentState        WorkflowState?         @relation("OrderCurrentState", fields: [currentStateId], references: [id])
  workflow            Workflow?              @relation(fields: [workflowId], references: [id])
  productionOutputs   ProductionOutput[]
  qualityChecks       QualityCheck[]
  reworkOrders        ReworkOrder[]
  vendorOrders        VendorOrder[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([boardId])
  @@index([status])
  @@index([workflowId])
}

model ManufacturingOrder {
  id                      String                 @id @default(cuid())
  tenantId                String
  orderId                 String
  moNumber                String
  name                    String
  description             String?
  type                    MOType                 @default("MAIN")
  isOutsourced            Boolean                @default(false)
  outsourcedType          String?
  vendorId                String?
  vendorOrderNumber       String?
  vendorQuoteNumber       String?
  vendorEstimatedCost     Float?
  vendorActualCost        Float?
  vendorLeadTimeDays      Int?
  vendorNotes             String?
  workflowId              String?
  currentStateId          String?
  status                  MOStatus               @default("PLANNED")
  plannedStartDate        DateTime?
  plannedEndDate          DateTime?
  actualStartDate         DateTime?
  actualEndDate           DateTime?
  progressPercent         Float                  @default(0)
  recipeId                String?
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  dependsOn               String?
  reservations            InventoryReservation[]
  transactions            InventoryTransaction[]
  jobsheets               Jobsheet[]
  vendor                  Supplier?              @relation(fields: [vendorId], references: [id])
  recipe                  Recipe?                @relation(fields: [recipeId], references: [id])
  currentState            WorkflowState?         @relation("MOCurrentState", fields: [currentStateId], references: [id])
  workflow                Workflow?              @relation(fields: [workflowId], references: [id])
  order                   Order                  @relation(fields: [orderId], references: [id])
  materialHandoffs        MaterialHandoff[]
  materialRequirements    MaterialRequirement[]
  productionOutputs       ProductionOutput[]
  qualityChecks           QualityCheck[]
  reworkOrders            ReworkOrder[]
  predecessorDependencies TaskDependency[]       @relation("MOToPredecessor")
  successorDependencies   TaskDependency[]       @relation("MOToSuccessor")
  vendorOrder             VendorOrder?

  @@unique([tenantId, orderId, moNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([workflowId])
  @@index([recipeId])
  @@index([vendorId])
  @@index([isOutsourced])
  @@index([dependsOn])
}

model Jobsheet {
  id                      String             @id @default(cuid())
  tenantId                String
  moId                    String
  jsNumber                String
  name                    String
  description             String?
  type                    JobsheetType       @default("SINGLE_PART")
  preparedBy              String?
  checkedBy               String?
  approvedBy              String?
  status                  JobsheetStatus     @default("PREPARING")
  dependsOn               String?
  plannedStartDate        DateTime?
  plannedEndDate          DateTime?
  actualStartDate         DateTime?
  actualEndDate           DateTime?
  progressPercent         Float              @default(0)
  drawingUrl              String?
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  manufacturingOrder      ManufacturingOrder @relation(fields: [moId], references: [id])
  materialAllocations     JobsheetMaterial[]
  machiningTasks          MachiningTask[]
  materialHandoffs        MaterialHandoff[]
  productionOutputs       ProductionOutput[]
  predecessorDependencies TaskDependency[]   @relation("JobsheetToPredecessor")
  successorDependencies   TaskDependency[]   @relation("JobsheetToSuccessor")

  @@unique([tenantId, moId, jsNumber])
  @@index([tenantId])
  @@index([moId])
  @@index([status])
  @@index([dependsOn])
}

model MachiningTask {
  id                      String                   @id @default(cuid())
  tenantId                String
  jobsheetId              String
  taskNumber              String
  name                    String
  description             String?
  machineId               String?
  status                  TaskStatus               @default("PENDING")
  plannedHours            Float?
  actualHours             Float?
  clockedInAt             DateTime?
  clockedOutAt            DateTime?
  breakdownAt             DateTime?
  breakdownNote           String?
  resolvedAt              DateTime?
  assignedTo              String?
  progressPercent         Float                    @default(0)
  dependsOn               String?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  plannedEndDate          DateTime?
  plannedStartDate        DateTime?
  assignedUser            User?                    @relation(fields: [assignedTo], references: [id])
  jobsheet                Jobsheet                 @relation(fields: [jobsheetId], references: [id])
  machine                 Machine?                 @relation(fields: [machineId], references: [id])
  materialHandoffs        MaterialHandoff[]
  productionOutputs       ProductionOutput[]
  predecessorDependencies TaskDependency[]         @relation("TaskToPredecessor")
  successorDependencies   TaskDependency[]         @relation("TaskToSuccessor")
  materialAllocations     TaskMaterialAllocation[]

  @@unique([tenantId, jobsheetId, taskNumber])
  @@index([tenantId])
  @@index([jobsheetId])
  @@index([machineId])
  @@index([status])
  @@index([assignedTo])
  @@index([dependsOn])
}

model TaskDependency {
  id                    String              @id @default(cuid())
  tenantId              String
  predecessorTaskId     String?
  predecessorJobsheetId String?
  predecessorMoId       String?
  predecessorOrderId    String?
  successorTaskId       String?
  successorJobsheetId   String?
  successorMoId         String?
  successorOrderId      String?
  dependencyType        DependencyType      @default("FINISH_TO_START")
  lagDays               Float               @default(0)
  isActive              Boolean             @default(true)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  successorMO           ManufacturingOrder? @relation("MOToPredecessor", fields: [successorMoId], references: [id])
  successorJobsheet     Jobsheet?           @relation("JobsheetToPredecessor", fields: [successorJobsheetId], references: [id])
  successorTask         MachiningTask?      @relation("TaskToPredecessor", fields: [successorTaskId], references: [id])
  predecessorMO         ManufacturingOrder? @relation("MOToSuccessor", fields: [predecessorMoId], references: [id])
  predecessorJobsheet   Jobsheet?           @relation("JobsheetToSuccessor", fields: [predecessorJobsheetId], references: [id])
  predecessorTask       MachiningTask?      @relation("TaskToSuccessor", fields: [predecessorTaskId], references: [id])

  @@unique([tenantId, predecessorTaskId, successorTaskId])
  @@index([tenantId])
  @@index([predecessorTaskId])
  @@index([successorTaskId])
  @@index([predecessorMoId])
  @@index([successorMoId])
}

model ProductionOutput {
  id                    String                 @id @default(cuid())
  tenantId              String
  outputNumber          String                 @unique
  taskId                String
  jobsheetId            String
  moId                  String
  orderId               String
  partNumber            String
  productName           String
  batch                 String?
  plannedQty            Float
  actualQty             Float
  goodQty               Float                  @default(0)
  reworkQty             Float                  @default(0)
  scrapQty              Float                  @default(0)
  status                ProductionOutputStatus @default("IN_PROGRESS")
  materialConsumed      String?
  startedAt             DateTime?
  completedAt           DateTime?
  qcPassed              Boolean                @default(false)
  qcCheckedAt           DateTime?
  qcCheckedBy           String?
  qcNotes               String?
  outputLocationId      String?
  outputShelfId         String?
  notes                 String?
  defectNotes           String?
  createdBy             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryTransactions InventoryTransaction[]
  qcInspector           User?                  @relation(fields: [qcCheckedBy], references: [id])
  outputShelf           Shelf?                 @relation("ProductionOutputShelf", fields: [outputShelfId], references: [id])
  outputLocation        Location?              @relation("ProductionOutputLocation", fields: [outputLocationId], references: [id])
  order                 Order                  @relation(fields: [orderId], references: [id])
  mo                    ManufacturingOrder     @relation(fields: [moId], references: [id])
  jobsheet              Jobsheet               @relation(fields: [jobsheetId], references: [id])
  task                  MachiningTask          @relation(fields: [taskId], references: [id])

  @@unique([tenantId, outputNumber])
  @@index([tenantId])
  @@index([taskId])
  @@index([jobsheetId])
  @@index([moId])
  @@index([status])
  @@index([partNumber])
}

model JobsheetMaterial {
  id                    String                   @id @default(cuid())
  tenantId              String
  jobsheetId            String
  materialRequirementId String?
  partNumber            String
  name                  String
  description           String?
  allocatedQty          Float
  availableQty          Float                    @default(0)
  consumedQty           Float                    @default(0)
  unit                  String?
  sourceBatch           String?
  sourceShelf           String?
  sourceLocation        String?
  status                JobsheetMaterialStatus   @default("ALLOCATED")
  notes                 String?
  allocatedBy           String?
  allocatedAt           DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  materialRequirement   MaterialRequirement?     @relation(fields: [materialRequirementId], references: [id])
  jobsheet              Jobsheet                 @relation(fields: [jobsheetId], references: [id])
  taskAllocations       TaskMaterialAllocation[]

  @@index([tenantId])
  @@index([jobsheetId])
  @@index([materialRequirementId])
  @@index([status])
}

model TaskMaterialAllocation {
  id                 String             @id @default(cuid())
  tenantId           String
  jobsheetMaterialId String
  taskId             String
  allocatedQty       Float
  consumedQty        Float              @default(0)
  wastedQty          Float              @default(0)
  remainingQty       Float              @default(0)
  unit               String?
  status             TaskMaterialStatus @default("ALLOCATED")
  consumedAt         DateTime?
  consumedBy         String?
  wasteReason        String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  task               MachiningTask      @relation(fields: [taskId], references: [id])
  jobsheetMaterial   JobsheetMaterial   @relation(fields: [jobsheetMaterialId], references: [id])

  @@index([tenantId])
  @@index([jobsheetMaterialId])
  @@index([taskId])
  @@index([status])
}

model Machine {
  id                String          @id @default(cuid())
  tenantId          String
  code              String
  name              String
  model             String?
  location          String?
  type              String?
  status            MachineStatus   @default("IDLE")
  capacity          Float?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  notes             String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  breakdowns        Breakdown[]
  machiningTasks    MachiningTask[]
  reworkTasks       ReworkTask[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model Breakdown {
  id             String        @id @default(cuid())
  tenantId       String
  machineId      String
  reportedBy     String
  reportedAt     DateTime      @default(now())
  type           BreakdownType @default("MECHANICAL")
  description    String
  notes          String?
  resolved       Boolean       @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  affectedTaskId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  machine        Machine       @relation(fields: [machineId], references: [id])

  @@index([tenantId])
  @@index([machineId])
  @@index([resolved])
  @@index([reportedAt])
}

model MaterialRequirement {
  id                   String                    @id @default(cuid())
  tenantId             String
  moId                 String
  recipeIngredientId   String?
  partNumber           String
  name                 String
  description          String?
  category             String?
  requiredQty          Float
  reservedQty          Float                     @default(0)
  requestedQty         Float                     @default(0)
  receivedQty          Float                     @default(0)
  consumedQty          Float                     @default(0)
  status               MaterialRequirementStatus @default("PLANNED")
  priority             Int                       @default(5)
  requiredDate         DateTime
  plannedOrderId       String?
  unit                 String?
  specifications       String?
  inventoryId          String?
  notes                String?
  createdBy            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  reservations         InventoryReservation[]
  jobsheetMaterials    JobsheetMaterial[]
  handoffItems         MaterialHandoffItem[]
  recipeIngredient     RecipeIngredient?         @relation(fields: [recipeIngredientId], references: [id])
  inventory            Inventory?                @relation(fields: [inventoryId], references: [id])
  mo                   ManufacturingOrder        @relation(fields: [moId], references: [id])
  purchaseRequestItems PurchaseRequestItem[]

  @@unique([tenantId, moId, partNumber])
  @@index([tenantId])
  @@index([moId])
  @@index([partNumber])
  @@index([status])
  @@index([requiredDate])
}

model PurchaseRequest {
  id                String                @id @default(cuid())
  tenantId          String
  prNumber          String
  title             String
  description       String?
  status            PurchaseRequestStatus @default("DRAFT")
  priority          Int                   @default(5)
  sourceType        String
  sourceMoId        String?
  sourceReference   String?
  supplierId        String?
  suggestedSupplier String?
  requiredDate      DateTime
  submittedAt       DateTime?
  approvedAt        DateTime?
  preparedBy        String?
  approvedBy        String?
  odooPrId          String?
  odooSyncedAt      DateTime?
  linkedPoId        String?
  totalItems        Int                   @default(0)
  estimatedAmount   Float                 @default(0)
  currency          String                @default("IDR")
  notes             String?
  createdBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  supplier          Supplier?             @relation(fields: [supplierId], references: [id])
  items             PurchaseRequestItem[]

  @@unique([tenantId, prNumber])
  @@index([tenantId])
  @@index([status])
  @@index([supplierId])
  @@index([sourceMoId])
  @@index([odooPrId])
}

model PurchaseRequestItem {
  id                    String               @id @default(cuid())
  tenantId              String
  purchaseRequestId     String
  materialRequirementId String?
  partNumber            String
  name                  String
  description           String?
  inventoryId           String?
  quantity              Float
  unitPrice             Float                @default(0)
  totalPrice            Float                @default(0)
  unit                  String?
  supplierId            String?
  supplierPartNumber    String?
  status                PRItemStatus         @default("PENDING")
  receivedQty           Float                @default(0)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  supplier              Supplier?            @relation(fields: [supplierId], references: [id])
  inventory             Inventory?           @relation(fields: [inventoryId], references: [id])
  materialRequirement   MaterialRequirement? @relation(fields: [materialRequirementId], references: [id])
  purchaseRequest       PurchaseRequest      @relation(fields: [purchaseRequestId], references: [id])

  @@index([tenantId])
  @@index([purchaseRequestId])
  @@index([materialRequirementId])
  @@index([inventoryId])
}

model Supplier {
  id                   String                @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  contactPerson        String?
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  supplierType         SupplierType          @default("MATERIAL")
  vendorTier           String?
  capabilities         String?
  certifications       String?
  leadTimeDays         Int?
  moq                  Int?
  paymentTerms         String?
  currency             String?               @default("IDR")
  creditLimit          Float?
  qualityRating        Float?                @default(5.0)
  deliveryRating       Float?                @default(5.0)
  priceRating          Float?                @default(5.0)
  totalOrders          Int                   @default(0)
  onTimeDelivery       Float?                @default(100)
  odooPartnerId        String?
  isActive             Boolean               @default(true)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventory            Inventory[]
  outsourcedMfgOrders  ManufacturingOrder[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequests     PurchaseRequest[]
  purchaseRequestItems PurchaseRequestItem[]
  vendorOrders         VendorOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([supplierType])
  @@index([odooPartnerId])
}

model VendorOrder {
  id                 String              @id @default(cuid())
  tenantId           String
  vendorOrderId      String              @unique
  vendorId           String
  orderId            String?
  moId               String?             @unique
  title              String
  description        String?
  referenceNumber    String?
  vendorQuoteNumber  String?
  outsourceType      OutsourceType       @default("FULL")
  workDescription    String
  quantity           Float
  unit               String?
  unitPrice          Float
  totalPrice         Float
  currency           String              @default("IDR")
  paymentTerms       String?
  orderDate          DateTime            @default(now())
  promisedDate       DateTime?
  actualDeliveryDate DateTime?
  vendorLeadTimeDays Int?
  daysRemaining      Int?
  status             VendorOrderStatus   @default("DRAFT")
  qualityRequired    Boolean             @default(true)
  qualityPassed      Boolean?
  qcNotes            String?
  shippingMethod     String?
  shippingCost       Float?
  trackingNumber     String?
  poDocument         String?
  packingList        String?
  certificate        String?
  notes              String?
  internalNotes      String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           VendorInvoice[]
  manufacturingOrder ManufacturingOrder? @relation(fields: [moId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  vendor             Supplier            @relation(fields: [vendorId], references: [id])
  items              VendorOrderItem[]
  shipments          VendorShipment[]

  @@unique([tenantId, vendorOrderId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([status])
  @@index([orderId])
}

model VendorOrderItem {
  id            String      @id @default(cuid())
  tenantId      String
  vendorOrderId String
  materialId    String?
  inventoryId   String?
  partNumber    String
  name          String
  description   String?
  quantity      Float
  unit          String?
  receivedQty   Float       @default(0)
  acceptedQty   Float       @default(0)
  rejectedQty   Float       @default(0)
  unitPrice     Float
  totalPrice    Float
  currency      String      @default("IDR")
  qcRequired    Boolean     @default(true)
  qcPassed      Boolean?
  defectCode    String?
  defectNotes   String?
  batchNumber   String?
  lotNumber     String?
  notes         String?
  createdAt     DateTime    @default(now())
  material      Inventory?  @relation(fields: [materialId], references: [id])
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorOrderId])
  @@index([materialId])
}

model VendorShipment {
  id               String         @id @default(cuid())
  tenantId         String
  vendorOrderId    String
  shipmentNumber   String         @unique
  shipmentType     String
  carrier          String?
  trackingNumber   String?
  quantity         Float
  unit             String?
  status           ShipmentStatus @default("SHIPPED")
  shippedDate      DateTime
  expectedDate     DateTime?
  receivedDate     DateTime?
  inspectedBy      String?
  inspectionResult String?
  inspectionNotes  String?
  notes            String?
  createdAt        DateTime       @default(now())
  vendorOrder      VendorOrder    @relation(fields: [vendorOrderId], references: [id])

  @@unique([tenantId, shipmentNumber])
  @@index([tenantId])
  @@index([vendorOrderId])
  @@index([status])
}

model VendorInvoice {
  id            String        @id @default(cuid())
  tenantId      String
  vendorOrderId String
  invoiceNumber String        @unique
  invoiceDate   DateTime
  dueDate       DateTime
  subtotal      Float
  tax           Float         @default(0)
  totalAmount   Float
  currency      String        @default("IDR")
  paidAmount    Float         @default(0)
  balanceDue    Float
  status        InvoiceStatus @default("PENDING")
  paymentDate   DateTime?
  paymentMethod String?
  paymentRef    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendorOrder   VendorOrder   @relation(fields: [vendorOrderId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([vendorOrderId])
  @@index([status])
}

model Location {
  id                String             @id @default(cuid())
  tenantId          String
  code              String
  name              String
  description       String?
  type              LocationType       @default("WAREHOUSE")
  parentLocationId  String?
  capacity          Int?
  area              Float?
  picUserId         String?
  building          String?
  floor             String?
  zone              String?
  isActive          Boolean            @default(true)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  inventory         Inventory[]
  picUser           User?              @relation("LocationPIC", fields: [picUserId], references: [id])
  parentLocation    Location?          @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations    Location[]         @relation("LocationHierarchy")
  incomingHandoffs  MaterialHandoff[]  @relation("HandoffToLocation")
  outgoingHandoffs  MaterialHandoff[]  @relation("HandoffFromLocation")
