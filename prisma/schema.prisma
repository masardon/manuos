  showCompletedTasks   Boolean  @default(false)
  rowsPerPage          Int      @default(25)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  value       String
  description String?
  type        String   @default("string")
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model QualityCheck {
  id                       String              @id @default(cuid())
  tenantId                 String
  qcNumber                 String              @unique
  referenceType            String
  referenceId              String
  orderId                  String?
  moId                     String?
  inventoryId              String?
  handoffId                String?
  checkType                QCType
  inspectionStage          String
  partNumber               String
  productName              String
  batch                    String?
  quantity                 Float
  unit                     String?
  status                   QCStatus            @default("PENDING")
  passQuantity             Float               @default(0)
  failQuantity             Float               @default(0)
  reworkQuantity           Float               @default(0)
  scrapQuantity            Float               @default(0)
  defectCode               String?
  defectDescription        String?
  defectCategory           String?
  inspectorId              String?
  inspectedAt              DateTime?
  dueDate                  DateTime?
  completedAt              DateTime?
  reworkRequired           Boolean             @default(false)
  customerApprovalRequired Boolean             @default(false)
  customerApproved         Boolean             @default(false)
  customerApprovedAt       DateTime?
  customerApprovedBy       String?
  notes                    String?
  attachments              String?
