  updatedAt                DateTime            @updatedAt
  inspector                User?               @relation(fields: [inspectorId], references: [id])
  handoff                  MaterialHandoff?    @relation(fields: [handoffId], references: [id])
  inventory                Inventory?          @relation(fields: [inventoryId], references: [id])
  manufacturingOrder       ManufacturingOrder? @relation(fields: [moId], references: [id])
  order                    Order?              @relation(fields: [orderId], references: [id])
  checkItems               QualityCheckItem[]
  reworkOrder              ReworkOrder?        @relation("QualityCheckToRework")

  @@unique([tenantId, qcNumber])
  @@index([tenantId])
  @@index([referenceType, referenceId])
  @@index([orderId])
  @@index([moId])
  @@index([status])
  @@index([checkType])
}

model QualityCheckItem {
