  @@index([tenantId])
  @@index([qualityCheckId])
  @@index([result])
}

model ReworkOrder {
  id                   String              @id @default(cuid())
  tenantId             String
  reworkNumber         String              @unique
  qualityCheckId       String              @unique
  orderId              String?
  moId                 String?
  inventoryId          String?
  reworkType           ReworkType
  priority             String              @default("MEDIUM")
  partNumber           String
  productName          String
  batch                String?
  quantity             Float
  unit                 String?
