  referenceType  String?
  referenceId    String?
  moId           String?
  jobsheetId     String?
  taskId         String?
  status         HandoffStatus         @default("PENDING")
  requestedAt    DateTime              @default(now())
  handedAt       DateTime?
  receivedAt     DateTime?
  notes          String?
  deliveryNote   String?
  trackingNumber String?
