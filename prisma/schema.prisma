  jobsheet       Jobsheet?             @relation(fields: [jobsheetId], references: [id])
  mo             ManufacturingOrder?   @relation(fields: [moId], references: [id])
  toLocation     Location              @relation("HandoffToLocation", fields: [toLocationId], references: [id])
  fromLocation   Location              @relation("HandoffFromLocation", fields: [fromLocationId], references: [id])
  items          MaterialHandoffItem[]
  qualityChecks  QualityCheck[]

  @@unique([tenantId, handoffNumber])
  @@index([tenantId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([moId])
  @@index([status])
  @@index([referenceType, referenceId])
}

model MaterialHandoffItem {
  id                    String               @id @default(cuid())
  tenantId              String
  handoffId             String
  inventoryId           String
  materialRequirementId String?
  partNumber            String
  name                  String
  quantity              Float
  unit                  String?
  fromBatch             String?
  toBatch               String?
  fromShelf             String?
  toShelf               String?
