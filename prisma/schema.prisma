  manufactureDate      DateTime?
  lotNumber            String?
  currentMoId          String?
  currentJobsheetId    String?
  currentTaskId        String?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
